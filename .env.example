# LLM Service Configuration
LLM_BASE_URL="http://mock-llm:8000/v1" # Example: http://localhost:8000/v1 for a local mock, or OpenAI API endpoint
OPENAI_API_KEY="sk-your-openai-key" # Required by OpenAI client, even if using a mock LLM

# Mock Social Server Configuration
MOCK_SOCIAL_URL="http://mock_social:8080" # This should match the service name and port in docker-compose.yml
MOCK_USERNAME="testuser"
MOCK_PASSWORD="testpassword"

# Human-in-the-Loop (HITL) Configuration
HITL_ENABLED="false" # Set to "true" to enable manual approval before posting
